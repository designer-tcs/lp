PORT=3001
FRONTEND_ORIGIN=http://localhost:8080,https://wellspringsacademy.in,https://www.wellspringsacademy.in

# Full CRM API URL (key included in the URL)
CRM_API_URL=https://www.zohoapis.in/crm/v7/functions/add_website_lead/actions/execute?auth_type=apikey&zapikey=your_api_key_here

# Set true to log every form → CRM request in the backend terminal
CRM_DEBUG=true

# How long to wait for Zoho before failing the lead submit (ms)
CRM_TIMEOUT_MS=15000
